using namespace std;
int factorial(int n);
int main()
{
	int n;
	cin>>n;
	int fact;
	if( n<0)
		cout<<"it is not positive num"<<endl;
		else
		{
			fact=factorial(n);
			cout<<"factorial of number is"<<fact<<endl;
		}
		system("pause");
	}
	int factorial(int n)
	{
		int temp;
		if(n<=1)
		return 1;
		else
		temp=n*factorial(n-1);
		return temp;
	}
